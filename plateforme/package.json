{
  "name": "plateforme-projets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plateforme de gestion de projets d'infrastructure (finances CFC, appels d'offres CAN, contrats, planning, documents SharePoint, ressources, assistant IA)",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "pret-a-lancer": "vite build --outDir pret-a-lancer/web --emptyOutDir && esbuild server/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=pret-a-lancer/serveur.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@azure/msal-browser": "^5.23.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
