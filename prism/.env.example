# Clé API Anthropic (utilisée uniquement côté serveur, jamais exposée au navigateur)
ANTHROPIC_API_KEY=
# Modèle de l'assistant. Par défaut claude-opus-5-5 ; claude-fable-5-2 est plus capable et deux fois plus cher.
PRISM_MODELE=
# Port du serveur (le front Vite redirige /api vers ce port en développement)
PORT=8787
